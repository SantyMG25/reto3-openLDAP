dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to * by dn.exact="gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth" manage by * break
olcAccess: {1}to attrs=userPassword by self write by set="[cn=administradores,ou=personal,dc=empresa,dc=test]/memberUid & user/uid" write by anonymous auth by * none
olcAccess: {2}to attrs=shadowLastChange by self write by users read by * none
olcAccess: {3}to dn.subtree="ou=personal,dc=empresa,dc=test" by set="[cn=administradores,ou=personal,dc=empresa,dc=test]/memberUid & user/uid" write by users read by * none
olcAccess: {4}to * by users read by * none
